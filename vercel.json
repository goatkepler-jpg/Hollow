{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(m1|m2|m3|s1|s2|s3|bg|nocturne-background).mp3",
      "headers": [
        {"key": "Content-Type", "value": "audio/mpeg"},
        {"key": "Cache-Control", "value": "public, max-age=86400"}
      ]
    }
  ]
}
